{
  "name": "Reseller",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome ou raz\u00e3o social do revendedor"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "Documento do revendedor (CPF ou CNPJ) \u2014 armazenado cifrado (AES-GCM)"
    },
    "cpf_cnpj_masked": {
      "type": "string",
      "description": "CPF/CNPJ mascarado para exibi\u00e7\u00e3o (LGPD): ***.***.***-45"
    },
    "person_type": {
      "type": "string",
      "enum": [
        "pessoa_fisica",
        "pessoa_juridica"
      ],
      "default": "pessoa_fisica"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "commission_rate": {
      "type": "number",
      "default": 0,
      "description": "Percentual de comiss\u00e3o (ex: 10 = 10%)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo",
        "pendente",
        "bloqueado"
      ],
      "default": "pendente"
    },
    "ixc_vendor_id": {
      "type": "string",
      "description": "ID do vendedor correspondente no IXCSoft"
    },
    "total_sales": {
      "type": "number",
      "default": 0
    },
    "total_commission": {
      "type": "number",
      "default": 0
    },
    "assigned_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}