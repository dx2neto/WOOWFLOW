{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "Documento do cliente (CPF ou CNPJ) \u2014 armazenado cifrado (AES-GCM)"
    },
    "cpf_cnpj_masked": {
      "type": "string",
      "description": "CPF/CNPJ mascarado para exibi\u00e7\u00e3o (LGPD): ***.***.***-45"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "contract_number": {
      "type": "string"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "ativo",
        "suspenso",
        "cancelado",
        "instalacao"
      ],
      "default": "ativo"
    },
    "financial_status": {
      "type": "string",
      "enum": [
        "em_dia",
        "pendente",
        "inadimplente",
        "negociando"
      ],
      "default": "em_dia"
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "monthly_fee": {
      "type": "number"
    },
    "installation_date": {
      "type": "string",
      "format": "date"
    },
    "pppoe_login": {
      "type": "string"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "bloqueado"
      ],
      "default": "online"
    },
    "sector": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}