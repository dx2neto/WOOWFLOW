{
  "name": "Sale",
  "type": "object",
  "properties": {
    "correlation_id": {
      "type": "string",
      "description": "ID de correla\u00e7\u00e3o que rastreia toda a jornada da venda entre IXC, cr\u00e9dito, ZapSign e Evolution"
    },
    "customer_name": {
      "type": "string"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "Documento do cliente (CPF ou CNPJ)"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "stage": {
      "type": "string",
      "enum": [
        "novo_lead",
        "cpf_validado",
        "ixc_consultado",
        "analise_debitos",
        "consulta_credito",
        "aprovado",
        "reprovado",
        "analise_manual",
        "contrato_gerado",
        "assinatura_enviada",
        "assinado",
        "ativacao",
        "concluido",
        "perdido"
      ],
      "default": "novo_lead"
    },
    "reseller_id": {
      "type": "string",
      "description": "ID do revendedor parceiro (entidade Reseller)"
    },
    "reseller_name": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "monthly_fee": {
      "type": "number"
    },
    "installation_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "neighborhood": {
      "type": "string"
    },
    "ixc_customer_id": {
      "type": "string",
      "description": "ID do cliente no IXCSoft"
    },
    "ixc_contract_id": {
      "type": "string",
      "description": "ID do contrato no IXCSoft"
    },
    "ixc_customer_exists": {
      "type": "boolean",
      "default": false
    },
    "ixc_financial_risk": {
      "type": "string",
      "enum": [
        "baixo",
        "medio",
        "alto"
      ],
      "description": "Risco financeiro calculado a partir de d\u00e9bitos no IXC"
    },
    "ixc_overdue_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de faturas vencidas no IXC"
    },
    "credit_check_id": {
      "type": "string",
      "description": "ID do CreditCheckLog relacionado"
    },
    "credit_decision": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_warning",
        "manual_review",
        "rejected",
        "pending"
      ]
    },
    "credit_reason": {
      "type": "string",
      "description": "Raz\u00e3o da decis\u00e3o de cr\u00e9dito"
    },
    "signature_request_id": {
      "type": "string"
    },
    "zapsign_doc_token": {
      "type": "string"
    },
    "sign_url": {
      "type": "string"
    },
    "whatsapp_sent": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_message_id": {
      "type": "string"
    },
    "whatsapp_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "sent",
        "failed",
        "retrying"
      ],
      "default": "pending"
    },
    "assigned_user_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "decision_reason": {
      "type": "string",
      "description": "Raz\u00e3o da decis\u00e3o final da venda"
    },
    "loss_reason": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico cronol\u00f3gico de mudan\u00e7as de etapa"
    }
  },
  "required": [
    "customer_name",
    "cpf_cnpj",
    "phone",
    "stage"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}