{
  "name": "CreditCheckLog",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "ID da venda (Sale) relacionada"
    },
    "correlation_id": {
      "type": "string"
    },
    "cpf_cnpj_masked": {
      "type": "string",
      "description": "CPF/CNPJ mascarado para LGPD (ex: ***.***.***-**)"
    },
    "customer_name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "default": "validocadastro",
      "description": "Provider de consulta (validocadastro, serasa, quod, boavista)"
    },
    "product_code": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "tipo_pessoa": {
      "type": "string",
      "enum": [
        "F",
        "J"
      ]
    },
    "result_status": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_warning",
        "manual_review",
        "rejected",
        "error"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_warning",
        "manual_review",
        "rejected"
      ],
      "description": "Decis\u00e3o do motor de pol\u00edticas"
    },
    "decision_reason": {
      "type": "string"
    },
    "has_restrictions": {
      "type": "boolean",
      "default": false
    },
    "restriction_count": {
      "type": "number",
      "default": 0
    },
    "performed_by_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que solicitou a consulta"
    },
    "performed_by_name": {
      "type": "string"
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lgpd_consent": {
      "type": "boolean",
      "default": true,
      "description": "Consentimento LGPD do cliente para consulta cadastral"
    },
    "purpose": {
      "type": "string",
      "default": "avaliacao_credito_venda",
      "description": "Finalidade da consulta conforme LGPD"
    },
    "response_summary": {
      "type": "string",
      "description": "Resumo sanitizado da resposta (sem dados sens\u00edveis)"
    }
  },
  "required": [
    "cpf_cnpj_masked",
    "provider",
    "result_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.performed_by_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}