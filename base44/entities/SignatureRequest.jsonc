{
  "name": "SignatureRequest",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_cpf_cnpj": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "ixc_customer_id": {
      "type": "string"
    },
    "ixc_contract_id": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "plan_value": {
      "type": "number"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_city": {
      "type": "string"
    },
    "ixc_data_snapshot": {
      "type": "string",
      "description": "JSON snapshot dos dados do contrato IXC no momento da gera\u00e7\u00e3o"
    },
    "template_id": {
      "type": "string",
      "description": "ID do ContractTemplate usado"
    },
    "template_name": {
      "type": "string"
    },
    "variables_used": {
      "type": "string",
      "description": "JSON das vari\u00e1veis preenchidas no template"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "contrato",
        "termo_adesao",
        "termo_comodato",
        "termo_permanencia",
        "aceite_eletronico",
        "aditivo"
      ],
      "default": "contrato"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "assinado",
        "expirado",
        "cancelado",
        "erro"
      ],
      "default": "pendente"
    },
    "zapsign_doc_token": {
      "type": "string",
      "description": "Token \u00fanico do documento no ZapSign",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "zapsign_open_id": {
      "type": "string",
      "description": "open_id (shortcode) do documento ZapSign"
    },
    "document_url": {
      "type": "string",
      "description": "URL p\u00fablica do documento para visualiza\u00e7\u00e3o/download"
    },
    "sign_url": {
      "type": "string",
      "description": "URL de assinatura enviada ao cliente"
    },
    "signers": {
      "type": "string",
      "description": "JSON array com dados dos signat\u00e1rios (nome, email, token, status)"
    },
    "signed_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "whatsapp_sent": {
      "type": "boolean",
      "default": false
    },
    "whatsapp_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "whatsapp_instance": {
      "type": "string"
    },
    "sent_by_user_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "default": "ZapSign"
    }
  },
  "required": [
    "customer_name",
    "phone",
    "document_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sent_by_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sent_by_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}