{
  "name": "CollectionCase",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "ixc_customer_id": {
      "type": "string"
    },
    "agreement_id": {
      "type": "string"
    },
    "ixc_invoice_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_cpf_cnpj": {
      "type": "string"
    },
    "customer_city": {
      "type": "string"
    },
    "original_amount": {
      "type": "number",
      "default": 0
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "days_late": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_contato",
        "promessa_pagamento",
        "negociando",
        "pago",
        "perdido"
      ],
      "default": "aberto"
    },
    "assigned_to": {
      "type": "string"
    },
    "attempts_count": {
      "type": "number",
      "default": 0
    },
    "last_attempt_at": {
      "type": "string"
    },
    "next_action_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "current_amount",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
