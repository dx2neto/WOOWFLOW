{
  "name": "IxcContract",
  "type": "object",
  "properties": {
    "ixc_contract_id": {
      "type": "string",
      "description": "ID do contrato no IXCSoft (cliente_contrato.id)"
    },
    "ixc_customer_id": {
      "type": "string",
      "description": "ID do cliente no IXCSoft"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente (raz\u00e3o social)"
    },
    "plan_name": {
      "type": "string",
      "description": "Nome do plano do contrato"
    },
    "ixc_plan_id": {
      "type": "string",
      "description": "ID do plano no IXCSoft"
    },
    "vendor_name": {
      "type": "string"
    },
    "ixc_vendor_id": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "cancelado",
        "suspenso",
        "outro"
      ],
      "default": "ativo"
    },
    "internet_status": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "download": {
      "type": "string"
    },
    "upload": {
      "type": "string"
    },
    "ip": {
      "type": "string"
    },
    "mac": {
      "type": "string"
    },
    "olt": {
      "type": "string"
    },
    "cto": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "raw_data": {
      "type": "string",
      "description": "JSON snapshot dos dados brutos do IXC"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ixc_contract_id",
    "customer_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}