{
  "name": "Aviso WhatsApp ao Assinar Contrato",
  "description": "Envia um aviso via WhatsApp para o cliente e para o setor comercial sempre que um contrato \u00e9 assinado no ZapSign (SignatureRequest.status = assinado).",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "SignatureRequest",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"assinado\" and .trigger.old_data.status != \"assinado\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "contract_signed_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyContractSigned",
            "args": {
              "signature_request_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar aviso de contrato assinado",
            "description": "WhatsApp para cliente e setor comercial"
          }
        }
      }
    ]
  }
}