{
  "name": "Sincroniza\u00e7\u00e3o Di\u00e1ria de Planos e Contratos IXC",
  "description": "Sincroniza planos e contratos do IXCSoft para as entidades IxcPlan e IxcContract diariamente \u00e0s 03:00",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_ixc_plans_contracts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_plans": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ixcApi",
            "args": {
              "action": "sync_plans"
            }
          },
          "then": "sync_contratos",
          "x-base44": {
            "title": "Sincronizar Planos IXC",
            "description": "Busca planos no IXCSoft e atualiza a entidade IxcPlan"
          }
        }
      },
      {
        "sync_contratos": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ixcApi",
            "args": {
              "action": "sync_contratos"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar Contratos IXC",
            "description": "Busca contratos no IXCSoft e atualiza a entidade IxcContract"
          }
        }
      }
    ]
  }
}