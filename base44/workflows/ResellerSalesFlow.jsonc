{
  "name": "Fluxo Autom\u00e1tico de Vendas \u2014 Revendedores",
  "description": "Quando um novo lead de revenda entra, consulta cr\u00e9dito no ValidaCadastro, classifica o lead e, se aprovado, gera contrato no IXCSoft e envia assinatura ZapSign via WhatsApp",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Sale",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.sale_type == \"revenda\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reseller_sales_flow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_credit_check": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "salesPipelineApi",
            "args": {
              "action": "run_credit_check",
              "sale_id": "${ .trigger.entity_id }",
              "lgpd_consent": true
            }
          },
          "then": "make_decision",
          "x-base44": {
            "title": "Consultar cr\u00e9dito no ValidaCadastro",
            "description": "Consulta cadastral autom\u00e1tica para venda de revenda"
          }
        }
      },
      {
        "make_decision": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "salesPipelineApi",
            "args": {
              "action": "make_decision",
              "sale_id": "${ .trigger.entity_id }"
            }
          },
          "then": "check_decision",
          "x-base44": {
            "title": "Classificar lead",
            "description": "Motor de decis\u00e3o combina cr\u00e9dito + risco IXC"
          }
        }
      },
      {
        "check_decision": {
          "switch": [
            {
              "when": "${ .make_decision.decision == \"approved\" or .make_decision.decision == \"approved_with_warning\" }",
              "then": "create_contract"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Cr\u00e9dito aprovado?",
            "description": "S\u00f3 prossegue se aprovado ou aprovado com ressalvas"
          }
        }
      },
      {
        "create_contract": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "salesPipelineApi",
            "args": {
              "action": "create_ixc_contract",
              "sale_id": "${ .trigger.entity_id }"
            }
          },
          "then": "send_signature",
          "x-base44": {
            "title": "Gerar contrato no IXCSoft",
            "description": "Cria cliente e contrato no IXC para revenda"
          }
        }
      },
      {
        "send_signature": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "salesPipelineApi",
            "args": {
              "action": "send_for_signature",
              "sale_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar assinatura ZapSign",
            "description": "Cria documento e envia link via WhatsApp ao cliente"
          }
        }
      }
    ]
  }
}