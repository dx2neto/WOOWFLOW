    }
  },
  "description": "Envia resumo diario com total de vendas, novos contratos assinados e pendencias de assinatura para o gestor comercial via WhatsApp, todos os dias as 08:00",
  "name": "Resumo Diario de Vendas",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_sales_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailySalesSummary",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar resumo diario via WhatsApp",
            "description": "Compila vendas e contratos do dia e envia ao gestor comercial"
          }
        }
      }
    ]
  }
