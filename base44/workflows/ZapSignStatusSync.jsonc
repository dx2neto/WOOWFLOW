{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "zapsign_status_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_signatures": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "zapsignApi",
            "args": {
              "action": "sync_status"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar assinaturas ZapSign",
            "description": "Atualiza status de documentos pendentes e propaga para contratos"
          }
        }
      }
    ]
  },
  "name": "Sincroniza\u00e7\u00e3o de Assinaturas ZapSign",
  "description": "Sincroniza o status das assinaturas do ZapSign a cada hora, atualizando os contratos e acordos relacionados na plataforma",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}