{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "installation_reminder_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendInstallationReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar confirma\u00e7\u00f5es de instala\u00e7\u00e3o",
            "description": "Mensagens WhatsApp para OS do dia"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Sao_Paulo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Envia confirma\u00e7\u00f5es autom\u00e1ticas de instala\u00e7\u00e3o via WhatsApp para OS agendadas do dia, todo dia \u00e0s 8h",
  "name": "Confirma\u00e7\u00e3o de Instala\u00e7\u00e3o via WhatsApp"
}